{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Host defaults",
      "description": "Native host build using CMake's default or selected generator and CC/CXX environment. Use a fresh build directory when changing compilers.",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "toolchain-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Windows"
        ]
      }
    },
    {
      "name": "gnu-base",
      "hidden": true,
      "inherits": "toolchain-base",
      "cacheVariables": {
        "CNC_TOOLCHAIN_COMPILER": "GNU"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "toolchain-base",
      "cacheVariables": {
        "CNC_TOOLCHAIN_COMPILER": "Clang"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "toolchain-base",
      "description": "Requires a Windows SDK and matching Visual Studio developer environment; IDEs may prepare that environment using the external architecture.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CNC_TOOLCHAIN_COMPILER": "MSVC"
      }
    },
    {
      "name": "clangcl-base",
      "hidden": true,
      "inherits": "msvc-base",
      "cacheVariables": {
        "CNC_TOOLCHAIN_COMPILER": "ClangCL"
      }
    },
    {
      "name": "linux-x86_64-gcc",
      "inherits": "gnu-base",
      "description": "Linux x86_64 with GCC, from Linux or Windows. Cross builds require a Linux-targeting GCC and target SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64.cmake"
    },
    {
      "name": "linux-x86_64-clang",
      "inherits": "clang-base",
      "description": "Linux x86_64 with Clang, from Linux or Windows. Cross builds require a Linux sysroot and target C/C++ runtimes.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64.cmake"
    },
    {
      "name": "linux-arm-gcc",
      "inherits": "gnu-base",
      "description": "Linux ARM soft-float with GCC, from Linux or Windows. Requires arm-linux-gnueabi compilers and matching SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm.cmake"
    },
    {
      "name": "linux-arm-clang",
      "inherits": "clang-base",
      "description": "Linux ARM soft-float with Clang, from Linux or Windows. Requires a matching Linux sysroot and target C/C++ runtimes.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm.cmake"
    },
    {
      "name": "linux-armhf-gcc",
      "inherits": "gnu-base",
      "description": "Linux ARMv7 hard-float with GCC, from Linux or Windows. Requires arm-linux-gnueabihf compilers and matching SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-armhf.cmake"
    },
    {
      "name": "linux-armhf-clang",
      "inherits": "clang-base",
      "description": "Linux ARMv7 hard-float with Clang, from Linux or Windows. Requires a matching Linux sysroot and target C/C++ runtimes.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-armhf.cmake"
    },
    {
      "name": "linux-arm64-gcc",
      "inherits": "gnu-base",
      "description": "Linux ARM64 with GCC, from Linux or Windows. Requires aarch64-linux-gnu compilers and matching SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake"
    },
    {
      "name": "linux-arm64-clang",
      "inherits": "clang-base",
      "description": "Linux ARM64 with Clang, from Linux or Windows. Requires a matching Linux sysroot and target C/C++ runtimes.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake"
    },
    {
      "name": "windows-i686-gcc",
      "inherits": "gnu-base",
      "description": "Windows i686 with MinGW GCC, from Linux or Windows. Requires matching MinGW compilers and target libraries.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-i686.cmake"
    },
    {
      "name": "windows-i686-clang",
      "inherits": "clang-base",
      "description": "Windows i686 with Clang's GNU ABI, from Linux or Windows. Requires LLVM-MinGW or a compatible MinGW SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-i686.cmake"
    },
    {
      "name": "windows-i686-msvc",
      "inherits": "msvc-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-i686.cmake",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "windows-i686-clangcl",
      "inherits": "clangcl-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-i686.cmake",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "windows-x86_64-gcc",
      "inherits": "gnu-base",
      "description": "Windows x86_64 with MinGW GCC, from Linux or Windows. Requires matching MinGW compilers and target libraries.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x86_64.cmake"
    },
    {
      "name": "windows-x86_64-clang",
      "inherits": "clang-base",
      "description": "Windows x86_64 with Clang's GNU ABI, from Linux or Windows. Requires LLVM-MinGW or a compatible MinGW SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x86_64.cmake"
    },
    {
      "name": "windows-x86_64-msvc",
      "inherits": "msvc-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x86_64.cmake",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-x86_64-clangcl",
      "inherits": "clangcl-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x86_64.cmake",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-arm64-gcc",
      "inherits": "gnu-base",
      "description": "Windows ARM64 with GCC, from Linux or Windows. Requires an ARM64-capable aarch64-w64-mingw32 GCC distribution and matching SDK; traditional x86 MinGW packages are insufficient.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64.cmake"
    },
    {
      "name": "windows-arm64-clang",
      "inherits": "clang-base",
      "description": "Windows ARM64 with Clang's GNU ABI, from Linux or Windows. Requires ARM64 LLVM-MinGW or a compatible SDK.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64.cmake"
    },
    {
      "name": "windows-arm64-msvc",
      "inherits": "msvc-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64.cmake",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-arm64-clangcl",
      "inherits": "clangcl-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-arm64.cmake",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      }
    },
